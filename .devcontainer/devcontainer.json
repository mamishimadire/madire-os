{
    // Build environment for Madire OS (GitHub Codespaces or VS Code Dev Containers).
    // Ubuntu 24.04 provides the versions the tests were pinned against
    // (QEMU 8.2.2, GRUB 2.12); scripts/install-deps.sh installs the toolchain.
    // The SSH server is needed by scripts/build.ps1 (gh codespace ssh / cp).
    "name": "Madire OS build",
    "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
    "features": {
        "ghcr.io/devcontainers/features/sshd:1": {}
    },
    "postCreateCommand": "bash scripts/install-deps.sh"
}
